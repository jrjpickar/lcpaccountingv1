export function json(data: any, status = 200): Response {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "content-type": "application/json", "cache-control": "no-store" },
  });
}

// Builds one Bill from a recurring template for the given occurrence date.
// Variable-amount templates estimate at the floor/ceiling midpoint and flag
// the bill so the UI can prompt for the real amount before it's approved.
export function generateBillFromTemplate(tpl: RecurringTemplate, occurrenceDate: string): Bill {
  const now = new Date().toISOString();
  const amount = tpl.isVariable
    ? Math.round((((tpl.varyFloor || 0) + (tpl.varyCeiling || 0)) / 2) * 100) / 100
    : Number(tpl.fixedAmount) || 0;

  const notes = tpl.isVariable
    ? `Auto-generated recurring bill (${tpl.frequency}). Amount varies - estimated at $${amount.toFixed(2)} ` +
      `(range $${Number(tpl.varyFloor).toFixed(2)}-$${Number(tpl.varyCeiling).toFixed(2)}). ` +
      `Confirm the actual amount before approving.`
    : `Auto-generated recurring bill (${tpl.frequency}).`;

  const bill: Bill = {
    id: "bill_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
    vendorId: tpl.vendorId,
    vendorName: tpl.vendorName,
    billNumber: tpl.billNumberPrefix ? `${tpl.billNumberPrefix}-${occurrenceDate}` : "",
    billDate: occurrenceDate,
    terms: tpl.terms,
    dueDate: addDays(occurrenceDate, daysFromTerms(tpl.terms)),
    lineItems: [{ description: tpl.description, category: tpl.category || "Uncategorized", amount }],
    amount: 0,
    notes,
    status: "pending",
    scheduledDate: null,
    payments: [],
    amountPaid: 0,
    balance: 0,
    createdAt: now,
    updatedAt: now,
    history: [{ ts: now, action: "created", note: `Generated from recurring template ${tpl.id}` }],
    recurringTemplateId: tpl.id,
    isEstimated: !!tpl.isVariable,
    varyFloor: tpl.isVariable ? tpl.varyFloor : null,
    varyCeiling: tpl.isVariable ? tpl.varyCeiling : null,
  };
  recompute(bill);
  return bill;
}
