// An error carrying the HTTP status it should produce. Throw this from
// inside a transactBlobJSON() mutate callback for a validation failure (bad
// input, wrong workflow state, not found) - it propagates straight out
// without writing anything, and the caller's catch block maps it back to
// the right response code instead of always going 500.
export class HttpError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
    this.name = "HttpError";
  }
}

const MAX_CAS_ATTEMPTS = 5;

// Read-modify-write against one Netlify Blobs JSON key with optimistic
// concurrency, so two writers touching the same store at the same instant
// (two clerks, or a clerk and the recurring-bills cron) can't silently
// clobber each other.
//
// `mutate` receives the current parsed value (or `fallback` if the key has
// never been written) and returns the next value to persist. Netlify Blobs'
// conditional writes (`onlyIfMatch` against the etag we just read, or
// `onlyIfNew` if the key didn't exist yet) report back `modified: false`
// instead of overwriting if someone else wrote in between our read and our
// write - when that happens we just re-read the fresh value and re-run
// `mutate` against it, so a validation check inside `mutate` (e.g. "is this
// bill still pending?") always runs against up-to-date data, even on a
// retry. Throwing inside `mutate` aborts immediately with nothing written,
// and is NOT treated as a write conflict - it propagates straight out to
// the caller.
export async function transactBlobJSON<T>(
  storeName: string,
  key: string,
  fallback: T,
  mutate: (current: T) => T | Promise<T>,
): Promise<T> {
  const store = getStore(storeName);

  for (let attempt = 0; attempt < MAX_CAS_ATTEMPTS; attempt++) {
    const existing = await store.getWithMetadata(key, { type: "json" });
    const current: T = existing && existing.data != null ? (existing.data as T) : fallback;

    const next = await mutate(current);

    const result = existing?.etag
      ? await store.setJSON(key, next, { onlyIfMatch: existing.etag })
      : await store.setJSON(key, next, { onlyIfNew: true });

    if (result.modified) return next;
    // Someone else wrote in the gap between our read and our write - loop
    // around, re-read whatever's there now, and re-run the mutation against
    // fresh data rather than stale data.
  }

  throw new Error(
    `Too much concurrent write contention on ${storeName}/${key} - gave up after ${MAX_CAS_ATTEMPTS} attempts.`,
  );
}

export type Payment = { id: string; amount: number; date: string; method: string; note?: string };
// `by` = who did it (display name; "system" for the cron). Missing on entries from before per-user sign-in.
export type HistoryEntry = { ts: string; action: string; note?: string; by?: string };
export type LineItem = { description: string; category: string; amount: number };
// "scheduled" was removed from the workflow - see foldLegacyScheduled() in
// bills.mts for how bills stored under it before that are handled.
export type BillStatus = "pending" | "approved" | "paid" | "rejected";

export type Bill = {
  id: string;
  vendorId: string | null;
  vendorName: string;
  billNumber: string;
  billDate: string;
  terms: string;
  dueDate: string;
  lineItems: LineItem[];
  amount: number;
  notes: string;
  status: BillStatus;
  // Legacy - only ever set by the removed "schedule" action. Kept on the
  // type so older stored bills still type-check; always null on new bills.
  scheduledDate: string | null;
  payments: Payment[];
  amountPaid: number;
  balance: number;
  createdAt: string;
  updatedAt: string;
  history: HistoryEntry[];
  // Set only on bills generated by a recurring template.
  recurringTemplateId?: string | null;
  isEstimated?: boolean;
  varyFloor?: number | null;
  varyCeiling?: number | null;
  // Client-generated id sent with a create request, used to dedupe a
  // double-submit or a retried request into a single bill instead of two.
  clientRequestId?: string | null;
};

export type Frequency = "weekly" | "biweekly" | "monthly" | "quarterly" | "yearly";

export type RecurringTemplate = {
  id: string;
  vendorId: string | null;
  vendorName: string;
  description: string;
  category: string;
  billNumberPrefix: string;
  terms: string;
  frequency: Frequency;
  startDate: string;
  endDate: string | null;
  isVariable: boolean;
  fixedAmount: number | null;
  varyFloor: number | null;
  varyCeiling: number | null;
  active: boolean;
  nextRunDate: string | null;
  lastRunDate: string | null;
  createdAt: string;
  updatedAt: string;
  history: HistoryEntry[];
};

export function daysFromTerms(terms: string): number {
  const m = /(\d+)/.exec(String(terms || ""));
  return m ? Number(m[1]) : 30;
}

export function addDays(dateStr: string, days: number): string {
  const d = new Date(dateStr + "T00:00:00Z");
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

export function todayISO(): string {
  return new Date().toISOString().slice(0, 10);
}

// --- Scheduled-function local-time gating -------------------------------
// Netlify's own cron scheduler only understands UTC - a schedule like
// "0 13 * * *" always means 13:00 UTC, whatever that happens to be in
// Pacific time on a given day of year. Rather than hand-editing a cron
// string twice a year (once each direction daylight saving flips), the
// scheduled functions that actually care about a Pacific wall-clock hour
// (run-recurring-bills.mts, check-overdue-invoices.mts) run on an hourly
// cron instead, and each checks the real local hour itself via Intl's own
// time zone database - which already knows the DST rules for any named
// zone, so "6am Pacific" resolves correctly whether that's UTC-7 or UTC-8
// that day, with nothing to update by hand ever again.
//
// SCHEDULE_TIMEZONE/SCHEDULE_HOUR are both optional env vars, so the
// target zone/hour can be tuned per deploy with no code change; unset,
// they default to what this app ships with - America/Los_Angeles, 6am.

export function currentHourInTimeZone(timeZone: string): number {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone,
    hour: "numeric",
    hour12: false,
  }).formatToParts(new Date());
  const raw = parts.find((p) => p.type === "hour")?.value;
  let hour = raw != null ? Number(raw) : NaN;
  if (hour === 24) hour = 0; // some engines render midnight as "24" with hour12:false
  return hour;
}

export function isTargetLocalHourNow(defaultHour: number): boolean {
  const timeZone = process.env.SCHEDULE_TIMEZONE || "America/Los_Angeles";
  const hour = Number(process.env.SCHEDULE_HOUR ?? defaultHour);
  return currentHourInTimeZone(timeZone) === hour;
}

// True only for an invocation Netlify's own cron actually triggered - its
// scheduled-function payload carries a `next_run` field. A manual hit on
// the function's own /api/... redirect (used for on-demand testing - see
// each function's own comments) has no such body, so it always runs
// regardless of the current local hour and testing never has to wait for
// the right time of day. If Netlify's payload shape ever changes and this
// stops matching, the safe direction is the one this defaults to: treat it
// as NOT a confirmed scheduled tick, which just means the local-hour gate
// gets skipped and the job runs every time it's invoked - harmless here,
// since both functions that use this are fully idempotent (re-running
// early just finds nothing new due yet).
export async function isScheduledInvocation(req: Request): Promise<boolean> {
  try {
    const body = await req.clone().json();
    return typeof body?.next_run === "string";
  } catch {
    return false;
  }
}

export function recompute(bill: Bill) {
  bill.amount = bill.lineItems.reduce((sum, li) => sum + (Number(li.amount) || 0), 0);
  bill.amountPaid = bill.payments.reduce((sum, p) => sum + (Number(p.amount) || 0), 0);
  bill.balance = Math.max(0, Math.round((bill.amount - bill.amountPaid) * 100) / 100);
}

// Sanity-checks a bill's own numbers right before it gets written back to
// the shared store - a last line of defense so a bug elsewhere can't
// silently persist a bill whose balance/amount/payments no longer add up.
// Throws (rather than returning a boolean) so callers can't accidentally
// ignore a failure; the caller's catch block turns it into a 500.
export function assertBillInvariant(bill: Bill): void {
  if (!(bill.amount >= 0)) throw new Error(`Bill ${bill.id}: amount cannot be negative`);
  if (!(bill.amountPaid >= 0)) throw new Error(`Bill ${bill.id}: amountPaid cannot be negative`);
  if (bill.amountPaid - bill.amount > 0.005) {
    throw new Error(`Bill ${bill.id}: amountPaid ($${bill.amountPaid.toFixed(2)}) exceeds amount ($${bill.amount.toFixed(2)})`);
  }
  const expectedBalance = Math.max(0, Math.round((bill.amount - bill.amountPaid) * 100) / 100);
  if (Math.abs(bill.balance - expectedBalance) > 0.005) {
    throw new Error(`Bill ${bill.id}: balance ($${bill.balance}) is out of sync with amount/amountPaid`);
  }
  if (bill.lineItems.some((li) => !(li.amount >= 0))) {
    throw new Error(`Bill ${bill.id}: a line item has a negative amount`);
  }
}

// Advances a YYYY-MM-DD date by one cycle of the given frequency.
//
// Monthly/quarterly are calendar-month math, clamped to the last valid day
// of the target month - "Jan 31" + monthly lands on "Feb 28"/"Feb 29",
// never overflows into March the way naive setUTCMonth() arithmetic would.
// Note this clamps against the CURRENT occurrence each time, not the
// original anchor day, so a bill anchored on the 31st will drift to the
// 28th/30th permanently after it first crosses a short month (the same
// trade-off most recurring-billing systems make - simple and predictable,
// just not "recover the 31st in a 31-day month" precise).
export function advanceDate(dateStr: string, frequency: Frequency): string {
  const d = new Date(dateStr + "T00:00:00Z");

  if (frequency === "weekly") {
    d.setUTCDate(d.getUTCDate() + 7);
    return d.toISOString().slice(0, 10);
  }
  if (frequency === "biweekly") {
    d.setUTCDate(d.getUTCDate() + 14);
    return d.toISOString().slice(0, 10);
  }
  if (frequency === "yearly") {
    d.setUTCFullYear(d.getUTCFullYear() + 1);
    return d.toISOString().slice(0, 10);
  }

  // monthly or quarterly
  const monthsToAdd = frequency === "quarterly" ? 3 : 1;
  const originalDay = d.getUTCDate();
  const targetMonthIndex = d.getUTCMonth() + monthsToAdd;
  const targetYear = d.getUTCFullYear() + Math.floor(targetMonthIndex / 12);
  const normalizedMonth = ((targetMonthIndex % 12) + 12) % 12;
  const daysInTargetMonth = new Date(Date.UTC(targetYear, normalizedMonth + 1, 0)).getUTCDate();
  const clampedDay = Math.min(originalDay, daysInTargetMonth);
  return new Date(Date.UTC(targetYear, normalizedMonth, clampedDay)).toISOString().slice(0, 10);
}

// --- Custom Reports dashboard -------------------------------------------
// A small, GHL-style "build your own dashboard" layout: an ordered list of
// widgets, each naming one metric from the client-side METRIC_REGISTRY
// (public/index.html) plus a size. The server doesn't know what a metric
// means or how to compute it - it only persists the layout (which widgets,
// in which order, at what size) so it's shared across everyone opening
// this site rather than reset per-browser. All the actual math (aging
// buckets, vendor/customer rollups, etc.) happens client-side from the
// already-loaded bills/recurring data and the live GHL pipeline totals.

export type ReportWidget = {
  id: string;
  metric: string;
  size: "sm" | "lg";
};

export type ReportConfig = {
  widgets: ReportWidget[];
  migrations?: string[];
};

