// --- Deals (wholesale) ---
// One record per GHL opportunity that's under contract or further along.
// GHL stays the source of truth for WHERE a deal is (its pipeline stage);
// this record holds the money side GHL doesn't track for us.
export type EmdStatus = "none" | "held" | "refunded" | "forfeited";
export type DealRecord = {
  opportunityId: string;
  propertyAddress?: string; // snapshot of the GHL opportunity name, so a deal that leaves the pipeline still reads right
  sellerName?: string;
  contractPrice: number | null; // what we're buying it for
  assignmentFee: number | null; // expected fee (spread)
  emdAmount: number | null; // earnest money we put up
  emdStatus: EmdStatus;
  emdDate?: string;
  buyerName: string;
  buyerContactId: string | null;
  buyerDeposit: number | null; // non-refundable deposit from the end buyer
  escrowCompany: string;
  escrowNumber: string;
  contractDate?: string;
  expectedCloseDate?: string;
  feeReceived: number | null; // what actually hit the account
  feeReceivedDate?: string;
  closingCosts: number | null; // anything we paid at close (title, etc.) - deducted in Reports
  notes: string;
  createdAt: string;
  updatedAt: string;
  updatedBy?: string;
  history: HistoryEntry[];
};

